import logging, asyncio, aiohttp
from aiogram import Bot, Dispatcher, F
from aiogram.types import Message, InlineKeyboardMarkup, InlineKeyboardButton, CallbackQuery
from aiohttp import web

TOKEN = "8613726826:AAEZJ0-OknC6NQHyV3O6F2l8yT68l13FEww"
bot = Bot(token=TOKEN)
dp = Dispatcher()

# Умная матрица контрпиков по типам механик героев
MCH = {
    "ILL": ["Earthshaker (Эхослэм)", "Sven (Сплэш)", "Axe (Крутилка)", "Leshrac", "Kunkka"],
    "CST": ["Anti-Mage (Щит)", "Silencer (Глобал)", "Nyx Assassin", "Pugna (Вард)", "Doom"],
    "SQS": ["Storm Spirit (Влет)", "Spectre (Влет через карту)", "Clockwerk", "Spirit Breaker"],
    "AGI": ["Slardar (Минус броня)", "Razor (Ворует урон)", "Viper (Откл. пассивки)", "Void"],
    "STR": ["Lifestealer (% урон)", "Ursa (Пассивка)", "Timbersaw (Чистый урон)", "Necrophos"],
    "HEL": ["Ancient Apparition (Запрет регена)", "Necrophos", "Viper", "Slardar", "Axe"]
}

# Сюда АВТОМАТИЧЕСКИ скачаются все 126+ героев Доты из архива Valve
POOL = {}
MENU = {"mid": [], "carry": [], "off": [], "supp": []}

# Функция авто-загрузки ВСЕХ существующих героев Dota 2 с сервера Valve
async def load_all_heroes():
    url = "https://githubusercontent.com"
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url) as response:
                if response.status == 200:
                    data = await response.json()
                    for h_id, h in data.items():
                        name = h['localized_name']
                        sys_name = h['name'].replace("npc_dota_hero_", "")
                        
                        # Определяем механику по основному атрибут героя
                        attr = h.get('primary_attr', 'str')
                        cat = "STR" if attr == "str" else ("AGI" if attr == "agi" else "CST")
                        
                        # Записываем в общую базу поиска (и на английском, и на русском)
                        POOL[sys_name.lower()] = (name, cat)
                        POOL[name.lower()] = (name, cat)
                        
                        # Сортируем по кнопкам ролей на основе ролей Valve
                        roles = h.get('roles', [])
                        if "Carry" in roles:
                            MENU["carry"].append((name, sys_name))
                        elif "Support" in roles:
                            MENU["supp"].append((name, sys_name))
                        elif h.get('attack_type') == "Ranged" and cat == "CST":
                            MENU["mid"].append((name, sys_name))
                        else:
                            MENU["off"].append((name, sys_name))
        except Exception as e:
            logging.error(f"Ошибка загрузки базы героев: {e}")

def get_main_menu():
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🔥 Мидеры", callback_data="page_mid_0"), InlineKeyboardButton(text="⚔️ Керри", callback_data="page_carry_0")],
        [InlineKeyboardButton(text="🛡️ Хардлайн", callback_data="page_off_0"), InlineKeyboardButton(text="🌀 Саппорты", callback_data="page_supp_0")]
    ])

def get_paginated_keyboard(rk: str, pg: int):
    hr = MENU[rk]; st = pg * 8; ed = st + 8; p_hr = hr[st:ed]; buttons = []; row = []
    for nm, sk in p_hr:
        row.append(InlineKeyboardButton(text=nm, callback_data=f"go_{sk}"))
        if len(row) == 2: buttons.append(row); row = []
    if row: buttons.append(row)
    nav = []
    if pg > 0: nav.append(InlineKeyboardButton(text="⬅️ Назад", callback_data=f"page_{rk}_{pg-1}"))
    if ed < len(hr): nav.append(InlineKeyboardButton(text="Далее ➡️", callback_data=f"page_{rk}_{pg+1}"))
    if nav: buttons.append(nav)
    buttons.append([InlineKeyboardButton(text="⬅️ В меню", callback_data="back_to_menu")])
    return InlineKeyboardMarkup(inline_keyboard=buttons)

async def calc(m_or_c, inp: str):
    sk = inp.strip().lower().replace(" ", "_").replace("-", "")
    if sk in POOL:
        name, cat = POOL[sk]
        counters = MCH.get(cat, ["Axe", "Slardar", "Doom"])
        res = f"⚔️ **АВТО-контрпик против {name}:**\n\n"
        for i, c in enumerate(counters, 1): res += f"{i}. **{c}**\n"
        res += f"\n_Выбери роль или введи имя героя с клавиатуры:_"
        if isinstance(m_or_c, Message): await m_or_c.answer(res, parse_mode="Markdown", reply_markup=get_main_menu())
        else: await m_or_c.message.edit_text(res, parse_mode="Markdown", reply_markup=get_main_menu())
    else:
        txt = "❌ Герой не найден.\nВведи имя любого персонажа на русском или английском (например: *пудж, бара, kez, marci*):"
        if isinstance(m_or_c, Message): await m_or_c.answer(txt, parse_mode="Markdown", reply_markup=get_main_menu())
        else: await m_or_c.message.edit_text(txt, parse_mode="Markdown", reply_markup=get_main_menu())

@dp.message(F.text == "/start")
async def cmd_start(m: Message): 
    await m.answer("🔮 **Всезнающий Dota 2 Бот готов!**\n\nЯ скачал базу Valve. Нажми кнопку роли или напиши имя абсолютно любого героя:", reply_markup=get_main_menu())

@dp.callback_query(F.data.startswith("page_"))
async def handle_pages(c: CallbackQuery):
    _, rk, pg = c.data.split("_")
    await c.message.edit_text("🎯 Выбери вражеского героя:", reply_markup=get_paginated_keyboard(rk, int(pg))); await c.answer()

@dp.callback_query(F.data == "back_to_menu")
async def handle_back(c: CallbackQuery): 
    await c.message.edit_text("Выбери категорию или напиши имя героя:", reply_markup=get_main_menu()); await c.answer()

@dp.callback_query(F.data.startswith("go_"))
async def handle_click(c: CallbackQuery): 
    sk = c.data.replace("go_", ""); await c.answer(); await calc(c, sk)

@dp.message()
async def check_text(m: Message): 
    await calc(m, m.text)

async def start_bot():
    logging.basicConfig(level=logging.INFO)
    await load_all_heroes() # Бот скачивает вообще всех 126+ героев при старте!
    asyncio.create_task(dp.start_polling(bot))
    app = web.Application()
    app.router.add_get('/', lambda r: web.Response(text="Live"))
    runner = web.AppRunner(app); await runner.setup()
    await web.TCPSite(runner, '0.0.0.0', 10000).start(); await asyncio.Event().wait()

if __name__ == "__main__": 
    asyncio.run(start_bot())
